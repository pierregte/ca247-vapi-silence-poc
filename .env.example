# Copy to .env for local testing only. On Render, set these as real
# Environment Variables in the service dashboard instead of committing a .env file.

PORT=3000

# Optional. Only used as a fallback to look up a call's monitor.controlUrl
# via GET /call/:id if it wasn't present on the incoming webhook payload.
VAPI_PRIVATE_KEY=

# hmac (default) | secret | none (none = local smoke-testing only)
AUTH_MODE=hmac

# Shared secret configured on the Vapi Custom Credential attached to this
# assistant's serverUrl. Required unless AUTH_MODE=none.
WEBHOOK_SECRET=

# Header names — must match whatever is configured on the Vapi Custom
# Credential (these are Vapi's defaults; only change if you named them
# differently at credential setup).
SIGNATURE_HEADER=x-vapi-signature
TIMESTAMP_HEADER=x-vapi-timestamp
LEGACY_SECRET_HEADER=x-vapi-secret

# How long a signed request's timestamp may lag/lead "now" before being
# rejected as a possible replay (ms).
REPLAY_WINDOW_MS=300000

# How long CA247 waits after the "Are you still there?" check-in for
# genuine customer speech before issuing the closing line + endCall.
SECOND_CHANCE_MS=5000

# The line spoken via monitor.controlUrl (say + endCallAfterSpoken:true)
# if the caller stays silent through the second-chance window.
CLOSING_LINE=It seems you're no longer there. Thank you for calling ABC Plumbing. Goodbye.
